{
  "version": 2,
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "runtime": "python@3.12"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/healthz",
      "dest": "/api/index.py"
    },
    {
      "src": "^/(?!api|_next/static|_next/image|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$)(.*)",
      "dest": "/index.html"
    }
  ]
}
