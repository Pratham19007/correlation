{
  "version": 2,
  "buildCommand": "pip install -q -r requirements.txt",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/healthz",
      "dest": "/api/index.py"
    },
    {
      "src": "^/(?!api|_next/static|_next/image|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$)(.*)",
      "dest": "/index.html"
    }
  ]
}
