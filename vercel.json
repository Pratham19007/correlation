{
  "version": 2,
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "public": true,
  "functions": {
    "api/index.py": {
      "runtime": "python3.11"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=$1"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.py?path=healthz"
    }
  ],
  "routes": [
    {
      "src": "^/(?!api).*",
      "dest": "index.html"
    }
  ]
}
